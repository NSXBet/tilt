# -*- mode: Python -*-
#
# Run from this directory:
#
#   tilt up --worktrees
#
# Tilt executes this file once for the main checkout and once for every
# .worktree/<name>/Tiltfile checkout. There is no branching: a declaration
# with worktree=True instantiates in every run (each worktree run gets its
# own clone); an unflagged one is main-run only — worktree runs skip it.

worktree_config(port_range=(30000, 30100))

allow_k8s_contexts(["orbstack", "docker-desktop", "kind-orbstack", "kind-kind"])

# Every run builds from its own checkout. Worktree runs build from THEIR
# checkout into their own image lineage (-wt-<worktree> tag), so a branch's
# edits never touch the main image. docker_build needs no flag: it is not
# worktree-gated, and the engine injects the branch image into the clone's
# pod.
docker_build(
    "wt-helm/api",
    "api/",
    dockerfile="api/Dockerfile",
    live_update=[
        fall_back_on(paths="api/go.mod"),
        sync("api/", "/app"),
        run("cd /app && go build -o server .", trigger="api/go.mod"),
    ],
)

# Branch-local stack: worktree=True. The main run renders the chart once;
# worktree runs never render helm — the flagged k8s_yaml loads as a
# zero-entity stub that the engine fills from main's rendered output,
# clone-stamped per worktree (api-wt-<worktree>: own Service DNS, own
# image) when it applies.
k8s_yaml(
    helm("chart", name="wt-helm", values=["chart/values.yaml"]),
    worktree=True,
)

# Same flag, matching its workload: attaches to the clone in worktree
# runs (forwards get registry-allocated local ports via local_port 0) and
# to the stable stack in the main run. With --gateway-port,
# <worktree>.tilt.localhost routes to each worktree's clone Service.
k8s_resource(
    "api",
    port_forwards=[port_forward(0, container_port=8080)],
    worktree=True,
)

# Shared foundation — main-run only (no flag), so worktree runs skip these
# declarations entirely: one Secret from layered env (shared untouched by
# every clone) and one postgres reached by its stable `postgres` DNS name.
# PVCs never clone (RWO), so this stays single-instance by design.
k8s_yaml(local(["bash", "env-to-secret.sh"], quiet=True))
k8s_yaml("infra.yaml")
k8s_resource("postgres", port_forwards=["5433:5432"])
