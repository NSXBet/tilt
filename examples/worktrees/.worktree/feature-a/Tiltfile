# -*- mode: Python -*-
#
# Run from this directory:
#
#   tilt up --worktrees
#
# Tilt executes this file once for the main checkout and once for every
# .worktree/<name>/Tiltfile checkout. There is no branching: a declaration
# with worktree=True instantiates in every run (each worktree run gets its
# own clone); an unflagged one is main-run only — worktree runs skip it.

worktree_config(port_range=(30000, 30100))

# Main-run only (no flag): one stable instance, shared by every worktree.
# Worktree runs skip this declaration entirely.
local_resource(
    "shared-api",
    cmd="true",
    serve_cmd="./serve.sh shared 10370",
    serve_port=10370,
    links=["http://localhost:10370"],
)

# Branch-local: worktree=True instantiates in every run. A worktree run
# gets its own clone (resource wt:<worktree>_app) whose serve port the
# port registry deconflicts per worktree and injects as $TILT_SERVE_PORT;
# the serve process binds the env var, never the authored request. Links
# include the <worktree>.tilt.localhost gateway URL.
local_resource(
    "app",
    cmd="true",
    serve_cmd="./serve.sh %s $TILT_SERVE_PORT" % worktree.name(),
    serve_port=30001,
    worktree=True,
)
