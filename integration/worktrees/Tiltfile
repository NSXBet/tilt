# -*- mode: Python -*-

# Multi-worktree e2e fixture — the incidents-admin shape in miniature
# (.agents/drafts/multi-worktree-parallel.md §11: local_resource + shared
# resources, no cluster).
#
# The SAME Tiltfile executes once per worktree (plan §3): worktree.name() is
# "" in the main run and the worktree name in each re-execution. Run with:
#
#   tilt up --worktrees
#
# Discovery is position-based (plan §2): every subdirectory of .worktree/
# containing a Tiltfile is a worktree named after its basename. The
# .worktree/wt-a and .worktree/wt-b checkouts here are strict pointers —
# each contains only `load_dynamic('../Tiltfile')` — so the run executes
# this root Tiltfile re-rooted at the checkout (plan §3 one-Tiltfile style;
# worktree.dir() == the checkout).

WT = worktree.name()

if WT == "":
    # ── main run: foundation ──
    # The shared services every worktree inherits (incidents-admin's
    # postgres/admin-bff-image layer). Defined ONCE here; worktree runs
    # that do not redefine them just depend on them.
    local_resource('shared-infra',
                   cmd='true',
                   serve_cmd=['./serve.sh', 'shared', '10070'],
                   links=['http://localhost:10070'])
else:
    # ── worktree run: this branch's own server ──
    # Each worktree serves on its OWN authored port: parallel servers, no
    # deconfliction needed for this fixture (the port registry handles
    # port_forward=0 and docker-compose published ports).
    serve_ports = {'wt-a': 10071, 'wt-b': 10072}
    local_resource(WT,
                   cmd='true',
                   serve_cmd=['./serve.sh', WT, str(serve_ports[WT])],
                   links=['http://localhost:%d' % serve_ports[WT]])
